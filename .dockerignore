# Exclude large and unnecessary files/directories from Docker build context
# Keep required files like pyproject.toml, quick_pp code and app/docker

# VCS
.git
.git/**

# Python caches
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/
env/

# Build artifacts
build/
dist/
*.egg-info/

# Node / frontend
node_modules/
quick_pp/app/frontend/node_modules/
quick_pp/app/frontend/.svelte-kit/
quick_pp/app/frontend/.output/
quick_pp/app/frontend/build/

# Data, outputs, ML runs (very large)
data/
mlruns/
uploads/
output/
outputs/
notebooks/

# postgres data
quick_pp/app/docker/data/postgres/

# Logs, temp
*.log
tmp/
.cache/

# Jupyter
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Allow required files explicitly
!pyproject.toml
!main.py
!quick_pp/app/docker/Dockerfile
!quick_pp/app/docker/Dockerfile-psycopg
!quick_pp/app/docker/docker-compose.yaml
!quick_pp/
!deploy/demo/
!notebooks/data/01_raw/36_7-3.las
!notebooks/data/01_raw/formation_pressure_data.csv
!notebooks/data/01_raw/VOLVE/15-9-19-A.las
!notebooks/data/01_raw/VOLVE/VOLVE_15-9_Surveys.csv
!notebooks/data/01_raw/COSTA/HW-3.las
!notebooks/data/01_raw/COSTA/HW-4.las
!notebooks/data/01_raw/COSTA/HW-5.las
!notebooks/data/01_raw/COSTA/HW_core_data_all.csv
