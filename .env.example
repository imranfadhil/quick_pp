# ===================================================================
#  quick_pp Environment Configuration
#  Copy this file to .env and adjust values as needed.
#  Note: On DigitalOcean deployments, deploy/sync.bat + configure-env.sh
#        automatically create .env and generate strong secrets.
# ===================================================================

# ---- Database ----
POSTGRES_USER=qpp_user
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=quick_pp
POSTGRES_PORT=5432

# Database connection URL used by FastAPI:
# Local SQLite (default for local Python CLI):
QPP_DATABASE_URL=sqlite:///./data/quick_pp.db
# Local PostgreSQL:
# QPP_DATABASE_URL=postgresql+psycopg2://qpp_user:change_this_strong_password@localhost:5432/quick_pp
# Docker / Droplet PostgreSQL (automatically set by deploy/configure-env.sh):
# QPP_DATABASE_URL=postgresql+psycopg2://qpp_user:change_this_strong_password@postgres:5432/quick_pp

# ---- Frontend & Reverse Proxy (Docker / Droplet) ----
# Empty by default so browser requests use relative paths (/quick_pp/...)
# through the unified Nginx reverse proxy (works on both localhost:8080 and Cloudflare Tunnel).
VITE_BACKEND_URL=

# Local bind address for the web container. Keep 127.0.0.1 so the app is only
# reachable via Cloudflare Tunnel (or local localhost:8080 in local Docker).
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Node memory limit (MB) for SvelteKit/Vite build inside qpp-frontend container
FRONTEND_MAX_OLD_SPACE=4096

# Public base URL of the app (optional; e.g. https://qpp.example.com)
PUBLIC_URL=

# ---- User Access Management (UAM) & Authentication ----
QPP_AUTH_SECRET_KEY=change_this_uam_secret_key
QPP_ADMIN_USERNAME=admin
QPP_ADMIN_EMAIL=admin@quickpp.local
QPP_ADMIN_PASSWORD=QuickPP@Admin2026!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=true

TAVILY_API_KEY=

# ---- Docker Hub Publishing (Optional: `quick_pp docker-publish`) ----
DOCKER_USERNAME=
DOCKER_PASSWORD=
